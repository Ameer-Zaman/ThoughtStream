PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/thoughtstream?retryWrites=true&w=majority
FRONTEND_URL=http://localhost:5173

# Google OAuth (same Client ID you use in the frontend)
GOOGLE_CLIENT_ID=

# Email (Nodemailer). If SMTP_HOST is empty, emails are printed in the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ThoughtStream <no-reply@thoughtstream.app>
